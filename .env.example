# ========================================================
# Frontend Environment Variables (Vite)
# ========================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
VITE_TURNSTILE_SITE_KEY=0x4AAAAAA...your-site-key-here
VITE_API_BASE_URL=https://api.pixir.in

# ========================================================
# Backend Environment Secrets (Cloudflare Workers)
# Set via: npx wrangler secret put <NAME>
# ========================================================
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
# TURNSTILE_SECRET_KEY=0x4AAAAAA...your-turnstile-secret
# TARGET_HASH_SECRET=your-cryptographic-salt-secret-minimum-32-chars
# ADMIN_SECRET=your-secure-admin-passphrase-here
